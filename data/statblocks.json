  "exp_reward": {
    "note": "EXP for a regular enemy, scaled by the role's HP multiplier (you are paid for the work) and by how far ahead of the player the enemy is.",
    "formula": "round(0.20 * level^2.32 * role.HP * catchup)",
    "catchup": {
      "formula": "clamp(1 + 0.12 * (enemy_level - player_level), 0.5, 2.0)",
      "why": "A player who flees a lot or explores little is paid more per fight, so avoiding combat never digs a hole grinding is the only way out of. Supports the no-grinding pillar and makes RUN a real option rather than a trap."
